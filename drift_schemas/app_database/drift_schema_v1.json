          "sql": "CREATE TABLE IF NOT EXISTS \"app_installations\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"installation_id\" TEXT NOT NULL UNIQUE, \"created_at_micros\" INTEGER NOT NULL, \"onboarding_completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"onboarding_completed\" IN (0, 1)), \"portfolio_generation\" INTEGER NOT NULL DEFAULT 1, \"last_reset_at_micros\" INTEGER NULL, PRIMARY KEY (\"id\"), CHECK (id = 1), CHECK (created_at_micros > 0), CHECK (portfolio_generation >= 1), CHECK (last_reset_at_micros IS NULL OR last_reset_at_micros >= created_at_micros)) STRICT;"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, \"updated_at_micros\" INTEGER NOT NULL, PRIMARY KEY (\"key\"), CHECK (updated_at_micros > 0)) STRICT;"
        }
      ]
    },
    {
      "name": "jpy_balances",
      "sql": [
