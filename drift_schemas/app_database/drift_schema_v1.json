          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"jpy_balances\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"available\" TEXT NOT NULL DEFAULT '1000000', \"reserved\" TEXT NOT NULL DEFAULT '0', \"updated_at_micros\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (id = 1), CHECK (updated_at_micros > 0)) STRICT;"
        }
      ]
    },
    {
      "name": "asset_positions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"asset_positions\" (\"symbol\" TEXT NOT NULL, \"quantity\" TEXT NOT NULL, \"total_cost_basis\" TEXT NOT NULL, \"reserved_quantity\" TEXT NOT NULL DEFAULT '0', \"updated_at_micros\" INTEGER NOT NULL, PRIMARY KEY (\"symbol\"), CHECK (symbol IN ('BTC', 'ETH', 'XRP', 'SOL', 'DOGE')), CHECK (updated_at_micros > 0)) STRICT;"
        }
      ]
    },
    {
      "name": "local_orders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_orders\" (\"id\" TEXT NOT NULL, \"installation_key\" INTEGER NOT NULL DEFAULT 1 REFERENCES app_installations (id) ON DELETE RESTRICT, \"portfolio_generation\" INTEGER NOT NULL, \"order_kind\" TEXT NOT NULL, \"side\" TEXT NOT NULL, \"symbol\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"is_terminal\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_terminal\" IN (0, 1)), \"requested_price\" TEXT NULL, \"requested_quantity\" TEXT NOT NULL, \"reserved_jpy\" TEXT NOT NULL DEFAULT '0', \"reserved_quantity\" TEXT NOT NULL DEFAULT '0', \"server_order_id\" TEXT NULL UNIQUE, \"idempotency_key\" TEXT NOT NULL UNIQUE, \"created_at_micros\" INTEGER NOT NULL, \"updated_at_micros\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (installation_key = 1), CHECK (portfolio_generation >= 1), CHECK (order_kind IN ('market', 'limit')), CHECK (side IN ('buy', 'sell')), CHECK (symbol IN ('BTC', 'ETH', 'XRP', 'SOL', 'DOGE')), CHECK ((order_kind = 'market' AND requested_price IS NULL) OR (order_kind = 'limit' AND requested_price IS NOT NULL)), CHECK (created_at_micros > 0), CHECK (updated_at_micros >= created_at_micros)) STRICT;"
        }
      ]
    },
    {
      "name": "trade_executions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"trade_executions\" (\"id\" TEXT NOT NULL, \"order_id\" TEXT NOT NULL UNIQUE REFERENCES local_orders (id) ON DELETE CASCADE, \"liquidity_role\" TEXT NOT NULL, \"price\" TEXT NOT NULL, \"quantity\" TEXT NOT NULL, \"gross_amount\" TEXT NOT NULL, \"fee\" TEXT NOT NULL, \"settlement_amount\" TEXT NOT NULL, \"executed_at_micros\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (liquidity_role IN ('maker', 'taker')), CHECK (executed_at_micros > 0)) STRICT;"
        }
      ]
    },
